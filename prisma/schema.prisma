generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  PLANNED
  BOOKED
  ARCHIVED

  @@map("JourneyStatus")
}

enum ReminderType {
  SEVEN_DAYS_BEFORE
  ONE_DAY_BEFORE
  BOOKING_OPEN
}

enum HolidayType {
  COMPANY
  PERSONAL_LEAVE
}

enum NotificationChannel {
  EMAIL
  DISCORD
  IN_APP
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  READ
}

enum UserRole {
  ADMIN
  USER
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String?
  passwordHash       String?
  role               UserRole           @default(USER)
  isActive           Boolean            @default(true)
  mustResetPassword  Boolean            @default(false)
  emailVerifiedAt    DateTime?
  timeZone           String             @default("Asia/Kolkata")
  weekendDays        Int[]              @default([0, 6])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tickets            TicketPlan[]
  holidays           Holiday[]
  sessions           Session[]
  accountTokens      AccountToken[]
  reminderDeliveries ReminderDelivery[]
  auditEvents        AuditLog[]         @relation("AuditActor")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AppSettings {
  id                         String   @id
  allowSignups               Boolean  @default(true)
  reminderEmailEnabled       Boolean  @default(true)
  reminderDiscordEnabled     Boolean  @default(false)
  reminderInAppEnabled       Boolean  @default(true)
  reminderSevenDaysEnabled   Boolean  @default(true)
  reminderOneDayEnabled      Boolean  @default(true)
  reminderBookingOpenEnabled Boolean  @default(true)
  bookingWindowDays          Int      @default(60)
  bookingOpenHour            Int      @default(8)
  bookingOpenMinute          Int      @default(0)
  pnrAutoSyncEnabled         Boolean  @default(false)
  pnrSyncIntervalMinutes     Int      @default(360)
  smtpUrl                    String?
  emailFrom                  String?
  discordWebhookUrl          String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model TicketPlan {
  id                     String             @id @default(cuid())
  userId                 String
  sourceCode             String
  sourceName             String?
  destinationCode        String
  destinationName        String?
  travelDate             DateTime           @db.Date
  bookingOpensAt         DateTime           @map("bookingOpenDate") @db.Timestamptz(3)
  status                 TicketStatus       @default(PLANNED)
  notes                  String?
  pnrEncrypted           String?            @map("pnr")
  pnrLast4               String?
  remindersEnabled       Boolean            @default(true)
  reminderEmailEnabled   Boolean            @default(true)
  reminderDiscordEnabled Boolean            @default(false)
  reminderInAppEnabled   Boolean            @default(true)
  version                Int                @default(1)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderSchedules      ReminderSchedule[]
  pnrSnapshot            PnrSnapshot?

  @@index([userId, travelDate])
  @@index([userId, bookingOpensAt])
  @@index([userId, status])
  @@map("Journey")
}

model PnrSnapshot {
  id             String     @id @default(cuid())
  ticketId       String     @unique
  provider       String
  trainNumber    String?
  trainName      String?
  bookedClass    String?
  providerStatus String?
  coach          String?
  seat           String?
  syncedAt       DateTime   @default(now())
  nextSyncAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  ticket         TicketPlan @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([nextSyncAt])
}

model ReminderSchedule {
  id          String             @id @default(cuid())
  ticketId    String             @map("journeyId")
  type        ReminderType
  dueAt       DateTime           @db.Timestamptz(3)
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  ticket      TicketPlan         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  deliveries  ReminderDelivery[]

  @@unique([ticketId, type])
  @@index([dueAt, processedAt])
  @@map("JourneyReminder")
}

model ReminderDelivery {
  id            String              @id @default(cuid())
  scheduleId    String
  userId        String
  channel       NotificationChannel
  status        DeliveryStatus      @default(PENDING)
  attemptCount  Int                 @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  readAt        DateTime?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  schedule      ReminderSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, channel])
  @@index([userId, channel, status, createdAt])
  @@index([status, nextAttemptAt])
}

model Holiday {
  id        String      @id @default(cuid())
  userId    String
  name      String
  date      DateTime    @db.Date
  type      HolidayType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, name])
  @@index([userId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
