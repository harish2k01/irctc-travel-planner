generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  phoneNumber       String?
  passwordHash      String?
  role              UserRole       @default(USER)
  isActive          Boolean        @default(true)
  mustResetPassword Boolean        @default(false)
  emailVerifiedAt   DateTime?
  timeZone          String         @default("Asia/Kolkata")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  accountTokens     AccountToken[]
  auditEvents       AuditLog[]     @relation("AuditActor")
  railWorkspace     RailWorkspace?
  railFiles         RailFile[]
  railJobs          RailJob[]
  railGoogle        RailGoogle?
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AppSettings {
  id           String   @id
  allowSignups Boolean  @default(true)
  bookingWindowDays Int @default(60)
  remindersEnabled Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  googleCalendarEnabled Boolean @default(true)
  ticketUploadsEnabled Boolean @default(true)
  calendarExportEnabled Boolean @default(true)
  smtpUrl      String?
  emailFrom    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model RailWorkspace {
  userId    String   @id
  version   Int      @default(1)
  payload   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RailFile {
  id        String
  userId    String
  name      String
  type      String
  size      Int
  payload   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, createdAt])
}

model RailJob {
  id         String    @id @default(cuid())
  userId     String
  key        String
  kind       String
  payload    String    @default("")
  dueAt      DateTime
  state      String    @default("PENDING")
  attempts   Int       @default(0)
  lease      String?
  leaseUntil DateTime?
  sentAt     DateTime?
  readAt     DateTime?
  lastError  String?
  providerId String?
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([state, dueAt])
}

model RailGoogle {
  userId     String    @id
  tokens     String
  calendarId String?
  eventIds   String[]  @default([])
  enabled    Boolean   @default(true)
  syncedAt   DateTime?
  lastError  String?
  lease      String?
  leaseUntil DateTime?
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
