{
  "name": "railwatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify": "npm run prisma:generate && npm run test:release && npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "predev": "node scripts/prepare-ticket-assets.mjs",
    "prebuild": "node scripts/prepare-ticket-assets.mjs",
    "test:release": "node --test scripts/release/version.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.2.10",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
